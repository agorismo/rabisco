# Copie para ".env" (ignorado pelo Git). NUNCA commite o .env.

# Token do bot: Discord Developer Portal -> seu app -> Bot -> Reset Token
DISCORD_TOKEN=cole-o-token-do-seu-bot-aqui

# Projeto Supabase (a chave anon/publishable é pública; o bot só LÊ posts públicos)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Endereço público do site (sem barra no final)
SITE_URL=https://seu-usuario.github.io/rabisco
